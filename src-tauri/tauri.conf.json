{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "budgethandler",
  "version": "0.1.0",
  "identifier": "com.mac.budgethandler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Budget Handler",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "startMenuFolder": "Budget Handler"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null
    },
    "shortDescription": "Hotel Budget Management System",
    "longDescription": "Budget Handler is a desktop application for managing hotel budgets, tracking income and expenses, and generating financial reports.",
    "copyright": "Copyright © 2026 Budget Handler",
    "category": "Finance"
  }
}